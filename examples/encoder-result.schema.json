{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://github.com/constmark/bloom/examples/encoder-result.schema.json",
  "title": "Bloom browser encoder result",
  "description": "Portable, bounded browser export of one validated embedding or bi-encoder reranking result.",
  "type": "object",
  "oneOf": [
    { "$ref": "#/definitions/embedding_result" },
    { "$ref": "#/definitions/rerank_result" }
  ],
  "definitions": {
    "embedding_result": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_version", "object", "model", "prompt_tokens", "vectors"],
      "properties": {
        "schema_version": { "const": 1 },
        "object": { "const": "bloom.embedding_result" },
        "model": { "$ref": "#/definitions/model" },
        "prompt_tokens": { "type": "integer", "minimum": 0 },
        "vectors": {
          "type": "array",
          "minItems": 1,
          "maxItems": 256,
          "items": { "$ref": "#/definitions/vector" }
        }
      }
    },
    "vector": {
      "type": "object",
      "additionalProperties": false,
      "required": ["index", "input", "embedding"],
      "properties": {
        "index": { "type": "integer", "minimum": 0, "maximum": 255 },
        "input": {
          "type": "string",
          "minLength": 1,
          "maxLength": 262144,
          "pattern": "^\\S(?:[\\s\\S]*\\S)?$"
        },
        "embedding": {
          "type": "array",
          "minItems": 1,
          "maxItems": 16384,
          "items": { "type": "number" }
        }
      }
    },
    "rerank_result": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "object",
        "id",
        "model",
        "query",
        "prompt_tokens",
        "results"
      ],
      "properties": {
        "schema_version": { "const": 1 },
        "object": { "const": "bloom.rerank_result" },
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9._:-]+$"
        },
        "model": { "$ref": "#/definitions/model" },
        "query": {
          "type": "string",
          "minLength": 1,
          "maxLength": 65536,
          "pattern": "^\\S(?:[\\s\\S]*\\S)?$"
        },
        "prompt_tokens": { "type": "integer", "minimum": 0 },
        "results": {
          "type": "array",
          "minItems": 1,
          "maxItems": 256,
          "items": { "$ref": "#/definitions/ranked_document" }
        }
      }
    },
    "ranked_document": {
      "type": "object",
      "additionalProperties": false,
      "required": ["index", "relevance_score", "document"],
      "properties": {
        "index": { "type": "integer", "minimum": 0, "maximum": 255 },
        "relevance_score": { "type": "number", "minimum": -1, "maximum": 1 },
        "document": {
          "type": "string",
          "minLength": 1,
          "maxLength": 262144,
          "pattern": "^\\S(?:[\\s\\S]*\\S)?$"
        }
      }
    },
    "model": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256,
      "pattern": "^[^\\u0000-\\u001f\\u007f-\\u009f]+$"
    }
  }
}
