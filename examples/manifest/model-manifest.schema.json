{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Bloom Model Manifest",
  "type": "object",
  "additionalProperties": true,
  "required": ["id", "family", "version", "license", "io_schema", "memory_profile", "files", "primary_dtype"],
  "properties": {
    "id": { "type": "string", "minLength": 1 },
    "family": {
      "oneOf": [
        { "type": "string", "minLength": 1 },
        {
          "type": "object",
          "required": ["Custom"],
          "properties": {
            "Custom": { "type": "string", "minLength": 1 }
          }
        }
      ]
    },
    "version": { "type": "string", "minLength": 1 },
    "description": { "type": "string" },
    "license": { "type": "string", "minLength": 1 },
    "source_url": { "type": "string" },
    "io_schema": {
      "type": "object",
      "required": ["inputs", "outputs"],
      "properties": {
        "inputs": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/definitions/modality" }
        },
        "outputs": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/definitions/modality" }
        }
      }
    },
    "memory_profile": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "min_ram_bytes": { "type": "integer", "minimum": 0 },
        "min_vram_bytes": { "type": "integer", "minimum": 0 },
        "recommended_ram_bytes": { "type": "integer", "minimum": 0 },
        "recommended_vram_bytes": { "type": "integer", "minimum": 0 }
      }
    },
    "files": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name", "format", "size_bytes", "required"],
        "properties": {
          "name": { "type": "string", "minLength": 1 },
          "format": {
            "enum": ["Safetensors", "Gguf", "OpenVinoIr", "TensorRtEngine", "Unknown"]
          },
          "size_bytes": { "type": "integer", "minimum": 0 },
          "hash_sha256": {
            "type": ["string", "null"],
            "pattern": "^[A-Fa-f0-9]{64}$"
          },
          "required": { "type": "boolean" }
        }
      }
    },
    "parameters": {
      "type": "object",
      "additionalProperties": true
    },
    "runtime_hints": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "preferred_backends": {
          "type": "array",
          "items": { "type": "string" }
        },
        "supports_mmap": { "type": "boolean" },
        "requires_streaming": { "type": "boolean" }
      }
    },
    "primary_dtype": {
      "enum": ["F32", "F16", "BF16", "Q8", "Q4", "I8", "U8", "I4", "NF4"]
    },
    "quantization": {
      "type": ["object", "null"],
      "additionalProperties": true,
      "properties": {
        "scheme": { "type": "string" },
        "bits": { "type": "integer", "minimum": 1, "maximum": 16 },
        "group_size": { "type": ["integer", "null"], "minimum": 1 },
        "act_order": { "type": "boolean" },
        "kv_cache_dtype": { "type": ["string", "null"] }
      }
    },
    "processors": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name", "kind"],
        "additionalProperties": true,
        "properties": {
          "name": { "type": "string", "minLength": 1 },
          "kind": {
            "oneOf": [
              { "enum": ["TextTokenizer", "Audio", "Image", "Video", "Tensor", "WorldState"] },
              {
                "type": "object",
                "required": ["Custom"],
                "properties": {
                  "Custom": { "type": "string", "minLength": 1 }
                }
              }
            ]
          },
          "version": { "type": "string" },
          "inputs": {
            "type": "array",
            "items": { "$ref": "#/definitions/modality" }
          },
          "outputs": {
            "type": "array",
            "items": { "$ref": "#/definitions/modality" }
          },
          "parameters": {
            "type": "object",
            "additionalProperties": true
          }
        }
      }
    }
  },
  "definitions": {
    "modality": {
      "enum": ["Text", "Audio", "Vision", "Video", "Tensor", "WorldState", "Action"]
    }
  }
}
