{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Bloom Plugin Or Model Package Manifest",
  "type": "object",
  "oneOf": [
    { "$ref": "#/definitions/runtime_plugin" },
    { "$ref": "#/definitions/model_package" }
  ],
  "definitions": {
    "metadata": {
      "type": "object",
      "required": ["name", "version", "description", "author", "license", "platforms", "min_runtime_version"],
      "additionalProperties": true,
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "version": { "type": "string", "minLength": 1 },
        "description": { "type": "string", "minLength": 1 },
        "author": { "type": "string", "minLength": 1 },
        "license": { "type": "string", "minLength": 1 },
        "homepage": { "type": "string" },
        "platforms": {
          "type": "array",
          "items": { "type": "string" }
        },
        "min_runtime_version": { "type": "string", "minLength": 1 }
      }
    },
    "entry_point": {
      "type": "object",
      "required": ["type", "path"],
      "additionalProperties": true,
      "properties": {
        "type": { "type": "string", "enum": ["native", "wasm", "remote", "subprocess"] },
        "path": { "type": "string", "minLength": 1 }
      }
    },
    "runtime_plugin": {
      "type": "object",
      "required": ["metadata", "entry_point"],
      "additionalProperties": true,
      "properties": {
        "metadata": { "$ref": "#/definitions/metadata" },
        "entry_point": { "$ref": "#/definitions/entry_point" },
        "supported_families": {
          "type": "array",
          "items": { "type": "string" }
        },
        "supported_dtypes": {
          "type": "array",
          "items": { "$ref": "#/definitions/dtype" }
        },
        "supported_formats": {
          "type": "array",
          "items": { "$ref": "#/definitions/format" }
        },
        "supported_devices": {
          "type": "array",
          "items": { "type": "string" }
        },
        "supported_modalities": {
          "type": "array",
          "items": { "$ref": "#/definitions/modality" }
        },
        "supports_streaming": { "type": "boolean" },
        "supports_quantized_models": { "type": "boolean" },
        "max_context_tokens": { "type": "integer", "minimum": 0 },
        "required_backends": {
          "type": "array",
          "items": { "type": "string" }
        },
        "example_models": {
          "type": "array",
          "items": { "type": "string" }
        },
        "device_class": { "type": "string" },
        "supports_mmap": { "type": "boolean" },
        "has_quantization_kernels": { "type": "boolean" },
        "memory_overhead_bytes": { "type": "integer", "minimum": 0 },
        "probe_script": { "type": "string" },
        "input_modalities": {
          "type": "array",
          "items": { "$ref": "#/definitions/modality" }
        },
        "output_modalities": {
          "type": "array",
          "items": { "$ref": "#/definitions/modality" }
        },
        "input_schema": { "type": "string" },
        "output_schema": { "type": "string" },
        "dependencies": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["name", "version", "kind"],
            "additionalProperties": true,
            "properties": {
              "name": { "type": "string", "minLength": 1 },
              "version": { "type": "string", "minLength": 1 },
              "kind": { "type": "string", "minLength": 1 }
            }
          }
        },
        "deterministic": { "type": "boolean" }
      }
    },
    "model_package": {
      "type": "object",
      "required": [
        "metadata",
        "family",
        "model_version",
        "primary_dtype",
        "quantizations",
        "files",
        "recommended_backends",
        "total_size_bytes",
        "source_url",
        "package_hash",
        "license_file",
        "io_description"
      ],
      "additionalProperties": true,
      "not": { "required": ["entry_point"] },
      "properties": {
        "metadata": { "$ref": "#/definitions/metadata" },
        "family": { "type": "string", "minLength": 1 },
        "model_version": { "type": "string", "minLength": 1 },
        "primary_dtype": { "$ref": "#/definitions/dtype" },
        "quantizations": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["name", "dtype", "size_bytes", "quality_score"],
            "additionalProperties": true,
            "properties": {
              "name": { "type": "string", "minLength": 1 },
              "dtype": { "$ref": "#/definitions/dtype" },
              "size_bytes": { "type": "integer", "minimum": 0 },
              "quality_score": { "type": "number", "minimum": 0 }
            }
          }
        },
        "files": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["path", "format", "size_bytes", "sha256"],
            "additionalProperties": true,
            "properties": {
              "path": { "type": "string", "minLength": 1 },
              "format": { "$ref": "#/definitions/format" },
              "size_bytes": { "type": "integer", "minimum": 0 },
              "sha256": { "type": "string", "pattern": "^[A-Fa-f0-9]{64}$" }
            }
          }
        },
        "recommended_backends": {
          "type": "array",
          "items": { "type": "string" }
        },
        "required_processors": {
          "type": "array",
          "items": { "type": "string" }
        },
        "total_size_bytes": { "type": "integer", "minimum": 0 },
        "source_url": { "type": "string", "minLength": 1 },
        "package_hash": { "type": "string", "minLength": 1 },
        "license_file": { "type": "string", "minLength": 1 },
        "io_description": { "type": "string", "minLength": 1 }
      }
    },
    "dtype": {
      "enum": ["F32", "F16", "BF16", "Q8", "Q4", "I8", "U8", "I4", "NF4", "Unknown"]
    },
    "format": {
      "enum": ["Safetensors", "Gguf", "OpenVinoIr", "TensorRtEngine", "Onnx", "Unknown"]
    },
    "modality": {
      "enum": ["Text", "Audio", "Vision", "Video", "Tensor", "WorldState", "Action"]
    }
  }
}
