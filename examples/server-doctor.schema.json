{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://github.com/constmark/bloom/blob/main/examples/server-doctor.schema.json",
  "title": "Bloom Server Doctor Report",
  "description": "A side-effect-free deployment readiness report emitted by bloom_server --doctor=json.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "object",
    "created",
    "bloom_version",
    "status",
    "summary",
    "checks"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "object": {
      "const": "bloom.server_doctor"
    },
    "created": {
      "type": "integer",
      "minimum": 0,
      "description": "Unix timestamp in whole seconds."
    },
    "bloom_version": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "status": {
      "$ref": "#/definitions/status"
    },
    "summary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["passed", "warnings", "failures"],
      "properties": {
        "passed": {
          "type": "integer",
          "minimum": 0
        },
        "warnings": {
          "type": "integer",
          "minimum": 0
        },
        "failures": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "checks": {
      "type": "array",
      "minItems": 1,
      "maxItems": 32,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "status", "message"],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]{0,63}$"
          },
          "status": {
            "$ref": "#/definitions/status"
          },
          "message": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1024
          },
          "remediation": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1024
          }
        }
      }
    }
  },
  "definitions": {
    "status": {
      "type": "string",
      "enum": ["pass", "warn", "fail"]
    }
  }
}
